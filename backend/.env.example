# AP Payment Fraud Sentinel — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to source control.

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite for local dev; swap for Postgres in production
DATABASE_URL=sqlite:///./sentinel.db

# ── RocketRide ─────────────────────────────────────────────────────────────────
# Local RocketRide instance (same .pipe files work locally and in Cloud)
ROCKETRIDE_URI=ws://localhost:8765
ROCKETRIDE_APIKEY=your_rocketride_api_key_here

# ── Calling Provider ───────────────────────────────────────────────────────────
# mock  → no real calls, deterministic simulation
# live  → requires BLAND_API_KEY and valid ROCKETRIDE setup
CALLING_MODE=mock

# Bland AI (used by RocketRide calling tool in live mode)
BLAND_API_KEY=your_bland_ai_api_key_here

# ── LLM Provider (used by RocketRide agent nodes) ─────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Fraud Thresholds ───────────────────────────────────────────────────────────
# Score >= this → payment HELD
HOLD_THRESHOLD_SCORE=60
# Score >= this → send to AI analysis agent
AI_ANALYSIS_THRESHOLD_SCORE=30

# ── CORS (frontend origin) ─────────────────────────────────────────────────────
# Comma-separated list
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
